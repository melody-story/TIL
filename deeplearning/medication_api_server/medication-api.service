[Unit]
Description=Medication Info Proxy API (FastAPI)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/medication_api_server
EnvironmentFile=/opt/medication_api_server/.env
ExecStart=/opt/medication_api_server/.venv/bin/uvicorn server:app \
  --host 127.0.0.1 \
  --port 8000 \
  --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
